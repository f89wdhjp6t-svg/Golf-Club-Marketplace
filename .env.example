# Server-side Anthropic API key used by the AI advisor, photo scanner, and
# sell-flow valuation. Get one at https://console.anthropic.com
# This key stays on the server — it is never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: override the Claude model used for these features.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Supabase project credentials, used for accounts and persisting listings
# and carts. Get these from your Supabase project's Settings -> API page.
# Both are safe to expose to the browser (NEXT_PUBLIC_*) — access to data
# is controlled by the Row Level Security policies in supabase/schema.sql,
# not by keeping these secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
