# Supabase project credentials, used for accounts, the shared family
# tracker, and the shared calendar. Get these from your Supabase project's
# Settings -> API page.
# Both are safe to expose to the browser (NEXT_PUBLIC_*) — access to data
# is controlled by the Row Level Security policies in supabase/schema.sql,
# not by keeping these secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
